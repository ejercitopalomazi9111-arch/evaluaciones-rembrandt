# ─── Sitio ───────────────────────────────────────────────────────────────────
# Dominio final. Se usa en canonical, sitemap, robots y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.irembrandt.com.mx

# ─── Formularios ─────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY el sitio NO se rompe: los formularios ofrecen enviar por
# correo o por teléfono con el mensaje ya redactado. Configúralo para que las
# solicitudes lleguen automáticamente al buzón del instituto.
RESEND_API_KEY=
CORREO_DESTINO=contacto@irembrandt.com.mx
# El dominio del remitente debe estar verificado en Resend.
CORREO_REMITENTE="Sitio web Instituto Rembrandt <sitio@irembrandt.com.mx>"

# Botón de WhatsApp. Formato E.164 sin el signo +, por ejemplo 524422182770.
# Déjalo vacío mientras la escuela no confirme que ese número tiene WhatsApp:
# el botón sólo aparece si esta variable está definida.
NEXT_PUBLIC_WHATSAPP=

# Desarrollo: '1' simula el envío sin llamar a la red.
SIMULAR_ENVIO=
